# Git-tracked: pinned/versioned Minecraft server config. Bump VERSION and
# DATAPACKS together in the same commit when upgrading - a data pack targets
# a Minecraft version range, so one can silently break with the other.
#
# Uses itzg/minecraft-server's real variable names directly (VERSION, not
# MC_VERSION) - this file is loaded via docker-compose.yml's env_file, which
# injects values straight into the container with no renaming/default layer.
VERSION=26.3

# One or more .zip URLs (e.g. from Modrinth). Must target the same VERSION.
# For more than one, put each URL on its own line inside the quotes:
# DATAPACKS="https://cdn.modrinth.com/data/<id1>/versions/<v1>/pack1.zip
# https://cdn.modrinth.com/data/<id2>/versions/<v2>/pack2.zip"
#
# BlazeandCave's Advancements Pack v1.21, pinned to the version that
# supports VERSION=26.3 (https://modrinth.com/datapack/blazeandcaves-advancements-pack).
# DATAPACKS="https://cdn.modrinth.com/data/VoVJ47kN/versions/Y2zZ5eSs/BlazeandCave%27s%20Advancements%20Pack%201.21.zip"
DATAPACKS=""

# Keeps DATAPACKS as the source of truth: on every (re)start, .zip files in
# world/datapacks/ that aren't in the current DATAPACKS list are deleted
# before it's reinstalled.
REMOVE_OLD_DATAPACKS=true

# Fabric mods, by Modrinth project slug (not URLs - itzg's image resolves the
# right build for TYPE/VERSION itself). One per line. fabric-api is listed
# explicitly rather than relied on as an auto-pulled dependency, since it's
# been known to get skipped (itzg/docker-minecraft-server#2091). Each mod
# must have a build published for VERSION=26.3 - Krypton and ModernFix don't
# yet (checked their Modrinth compatibility lists on 2026-09-17), so they're
# left out for now; add them once they catch up.
#
# c2me-fabric:alpha - mc-image-helper only picks "release"-tagged Modrinth
# versions by default, but C2ME's 26.3 build (and its 26.2 one before it) is
# tagged alpha upstream; that's just how that project labels its builds, not
# a sign it's unstable. Override just this one project rather than loosening
# MODRINTH_PROJECTS_DEFAULT_VERSION_TYPE for all of them.
MODRINTH_PROJECTS="fabric-api
lithium
c2me-fabric:alpha
ferrite-core"

# Mirrors REMOVE_OLD_DATAPACKS: keeps MODRINTH_PROJECTS the source of truth
# for mods/ the same way, so dropping a mod from the list actually removes it
# on next restart instead of leaving a stale jar behind.
REMOVE_OLD_MODS=true

# Required for the whitelist below to be trustworthy (prevents UUID spoofing).
ONLINE_MODE=TRUE

# Fixed policy: this server always enforces its whitelist.
ENABLE_WHITELIST=TRUE
ENFORCE_WHITELIST=TRUE

# Comma-separated usernames. Tracked here (not .env) for an audit trail of
# who was ever added/removed - every change is a reviewable git commit.
WHITELIST=ListokVostoka,Sergey31,AbsentCast,Julia46kap
OPS=ListokVostoka
