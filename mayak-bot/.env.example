# Copy to mayak-bot/.env and edit. Gitignored - this repo is public and
# Telegram user IDs are personally-identifying (see ALLOWLIST below).
#
# RCON_PASSWORD is NOT here - it's shared with server/backup and comes
# from root .env via docker-compose.yml's interpolation, same as those
# two services. Only bot-specific values with no interpolation need go
# in this file.

# Get this from @BotFather on Telegram when you create the bot.
TELOXIDE_TOKEN=change-me

# One "telegram_id:minecraft_username" pair per line. Get each friend's
# numeric Telegram ID via @userinfobot on Telegram.
ALLOWLIST="123456789:ListokVostoka
555555555:blahblah"
