# Copy to mayak-backup/.env and edit. Gitignored.
#
# Loaded via docker-compose.yml's env_file, injected directly into the
# container (no renaming/default layer, so these use restic's/AWS SDK's
# real variable names). Unlike the root .env, there's no fail-fast check
# here if you leave a required value blank - restic will just fail with
# its own (less friendly) auth error at backup time.

# ---------- restic (required) ----------
RESTIC_PASSWORD=change-me-different-long-random
RESTIC_REPOSITORY=s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET>/mayak

# ---------- R2/S3 credentials (optional) ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto      # R2 uses "auto"
