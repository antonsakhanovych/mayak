# Copy to .env and edit. .env is gitignored.

# ---------- server ----------
MC_VERSION=26.2               # pin, don't use LATEST: Paper's API names new
                              # releases without the "1." prefix (e.g. 26.2,
                              # not 1.26.2), so LATEST can resolve to a string
                              # Paper's installer rejects as unavailable
MC_MEMORY=4G
SERVER_PORT=25565
RCON_PASSWORD=change-me-long-random
ONLINE_MODE=TRUE             # leave TRUE — required for the whitelist to be trustworthy

# ---------- whitelist (wire up later) ----------
ENABLE_WHITELIST=FALSE       # TRUE -> white-list=true in server.properties
ENFORCE_WHITELIST=FALSE      # TRUE -> kick non-whitelisted players on reload
WHITELIST=                   # comma-separated usernames, e.g. alice,bob
OPS=                         # comma-separated operator usernames

# ---------- data packs ----------
# One or more .zip URLs (e.g. from Modrinth). Must target the same MC_VERSION.
# Applied on container (re)start. For more than one, quote the value and put
# each URL on its own line:
# DATAPACKS="https://cdn.modrinth.com/data/<id1>/versions/<v1>/pack1.zip
# https://cdn.modrinth.com/data/<id2>/versions/<v2>/pack2.zip"
DATAPACKS=

# ---------- data ----------
DATA_DIR=./data

# Secondary (local) backup target. Point at a real mountpoint on hosts that have
# one (e.g. an external HDD), then `touch <that path>/.mayak-enabled` to turn it
# on for that host. Left as-is, local backups are skipped and only the cloud
# backup runs.
LOCAL_BACKUP_DIR=./.local-backup

# ---------- restic / Cloudflare R2 ----------
RESTIC_PASSWORD=change-me-different-long-random
RESTIC_REPOSITORY=s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET>/mayak
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto      # R2 uses "auto"
BACKUP_INTERVAL=3600         # seconds between backup cycles
BACKUP_STARTUP_DELAY=60      # grace period before the first cycle
RETENTION_HOURLY=24
RETENTION_DAILY=7
RETENTION_WEEKLY=4
