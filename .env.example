# Copy to .env and edit. .env is gitignored.
#
# Everything here is needed for docker-compose.yml's own port/volume
# interpolation (ports:/volumes: lines) or is used by both services -
# env_file (used by mayak-mc/.env, mayak-backup/.env) can't feed either of
# those, only a real project .env can. Values specific to one service and
# not needed for interpolation live in that service's own directory:
# mayak-mc/.env.example, mayak-backup/.env.example - copy those too.

# ---------- server ----------
SERVER_PORT=25565            # server-only; stuck here because ports: needs interpolation
RCON_PASSWORD=change-me-long-random   # shared: server sets it, backup authenticates with it

# ---------- data ----------
DATA_DIR=./mayak-mc/data     # shared: server mounts read-write, backup mounts read-only
