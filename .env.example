# Copy to .env and edit. .env is gitignored.
#
# Minecraft version/data packs/whitelist policy live in mc.env, backup
# retention policy lives in backup.env - both git-tracked. See those files,
# not this one, for that config.

# ---------- server ----------
MC_MEMORY=4G
SERVER_PORT=25565
RCON_PASSWORD=change-me-long-random

# ---------- data ----------
DATA_DIR=./data

# Secondary (local) backup target. Point at a real mountpoint on hosts that have
# one (e.g. an external HDD), then `touch <that path>/.mayak-enabled` to turn it
# on for that host. Left as-is, local backups are skipped and only the cloud
# backup runs.
LOCAL_BACKUP_DIR=./.local-backup

# ---------- restic / Cloudflare R2 ----------
RESTIC_PASSWORD=change-me-different-long-random
RESTIC_REPOSITORY=s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET>/mayak
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto      # R2 uses "auto"
